generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// Enums
// ==========================================

enum UserRole {
  SUPER_ADMIN
  PROVIDER // Renombrado de DENTIST - cualquier profesional de salud
  CLINIC_ADMIN // NUEVO - administrador de clínica
  STAFF_MANAGER // NUEVO - staff que gestiona agenda/pacientes
  STAFF_RECEPTIONIST
  STAFF_BILLING
  STAFF_ASSISTANT
  PATIENT
}

enum MedicalSpecialty {
  GENERAL_DENTISTRY
  ORTHODONTICS
  ENDODONTICS
  PERIODONTICS
  ORAL_SURGERY
  PEDIATRIC_DENTISTRY
  PROSTHODONTICS
  GENERAL_MEDICINE
  INTERNAL_MEDICINE
  PEDIATRICS
  CARDIOLOGY
  DERMATOLOGY
  OPHTHALMOLOGY
  GYNECOLOGY
  PSYCHOLOGY
  PSYCHIATRY
  PHYSIOTHERAPY
  NUTRITION
  SPEECH_THERAPY
  OCCUPATIONAL_THERAPY
  OTHER
}

enum ConsentStatus {
  PENDING
  GRANTED
  DENIED
  REVOKED
  EXPIRED
}

enum DataAccessLevel {
  FULL
  CLINICAL_ONLY
  SCHEDULING_ONLY
  DOCUMENTS_SHARED
  MINIMAL
}

enum ProviderPatientRelationType {
  REGISTERED_BY_PROVIDER
  LINKED_BY_PATIENT
  MUTUAL
  PROVIDER_ONLY
}

enum SubscriptionTier {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum CancellationFeeType {
  PERCENTAGE
  FIXED
  NONE
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  PENDING_INVITATION
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum WaitlistStatus {
  WAITING
  CONTACTED
  SCHEDULED
  CANCELLED
  EXPIRED
}

enum NotificationType {
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

enum NotificationChannel {
  APPOINTMENT_REMINDER
  APPOINTMENT_CONFIRMATION
  APPOINTMENT_CANCELLATION
  WAITLIST_UPDATE
  PAYMENT_REMINDER
  MARKETING
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  SUSPEND
  REACTIVATE
  IMPERSONATE
  EXPORT
  VIEW
}

enum TreatmentPlanStatus {
  DRAFT
  PROPOSED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TreatmentItemStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  CHECK
  INSURANCE
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum DocumentType {
  XRAY
  PHOTO
  CONSENT_FORM
  MEDICAL_RECORD
  PRESCRIPTION
  INVOICE
  INSURANCE_CLAIM
  OTHER
}

enum ToothCondition {
  HEALTHY
  CAVITY
  FILLED
  CROWN
  BRIDGE
  IMPLANT
  MISSING
  EXTRACTION_NEEDED
  ROOT_CANAL
  FRACTURED
  WORN
  ABSCESS
}

enum ToothSurface {
  OCCLUSAL
  MESIAL
  DISTAL
  BUCCAL
  LINGUAL
  INCISAL
}

enum EmailTemplateType {
  WELCOME
  TRIAL_EXPIRING
  TRIAL_EXPIRED
  SUBSCRIPTION_ACTIVATED
  SUBSCRIPTION_CANCELLED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  PASSWORD_RESET
  INVITATION
  SUPPORT_TICKET_CREATED
  SUPPORT_TICKET_UPDATED
  TENANT_CREATED
  USER_CREATED
}

enum ChatSessionStatus {
  ACTIVE
  HUMAN_TAKEOVER
  CLOSED
}

enum ChatMessageSender {
  BOT
  PATIENT
  STAFF
}

enum CalendarProvider {
  GOOGLE
  OUTLOOK
  APPLE
}

// ==========================================
// Core Models
// ==========================================

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String?  @map("password_hash")
  phone        String?
  role         UserRole @default(PATIENT)
  avatarUrl    String?  @map("avatar_url")

  // Campos profesionales (para PROVIDER)
  licenseNumber String?            @map("license_number")
  npiNumber     String?            @map("npi_number")
  specialties   MedicalSpecialty[] // CAMBIO: array de especialidades (antes era specialization String?)
  bio           String?            @db.Text // NUEVO

  // OAuth
  oauthProvider String? @map("oauth_provider")
  oauthId       String? @map("oauth_id")

  // Preferencias (NUEVO)
  language String @default("es")
  timezone String @default("America/Santo_Domingo")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ownedTenants        Tenant[]             @relation("TenantOwner")
  tenantMemberships   TenantMembership[]
  patientProfile      Patient?
  sessions            Session[]
  auditLogs           AuditLog[]
  passwordResetTokens PasswordResetToken[]
  managedClinics      Clinic[]             @relation("ClinicAdmin") // NUEVO
  providerModules     ProviderModule[] // NUEVO

  // Phase 6 specialty modules (as provider)
  providedExercisePlans         ExercisePlan[]
  providedFunctionalAssessments FunctionalAssessment[]
  providedSkinLesions           SkinLesion[]
  providedEyeExams              EyeExam[]
  providedLensPrescriptions     LensPrescription[]
  providedCardiacAssessments    CardiacAssessment[]
  providedGrowthRecords         GrowthRecord[]
  providedVaccinationRecords    VaccinationRecord[]
  providedNutritionPlans        NutritionPlan[]
  providedBodyMeasurements      BodyMeasurement[]
  providedGynecologicalExams    GynecologicalExam[]

  @@unique([oauthProvider, oauthId])
  @@map("users")
}

model Tenant {
  id        String @id @default(uuid())
  ownerId   String @map("owner_id")
  name      String
  subdomain String @unique

  // NUEVO: tipo de práctica
  practiceType MedicalSpecialty @default(GENERAL_DENTISTRY) @map("practice_type")

  subscriptionTier   SubscriptionTier   @default(STARTER) @map("subscription_tier")
  subscriptionStatus SubscriptionStatus @default(TRIAL) @map("subscription_status")
  stripeCustomerId   String?            @map("stripe_customer_id")
  trialEndsAt        DateTime?          @map("trial_ends_at")

  maxPatients Int @default(100) @map("max_patients")
  storageGB   Int @default(5) @map("storage_gb")

  whatsappConnected Boolean @default(false) @map("whatsapp_connected")

  // Políticas de cancelación
  cancellationMinHours     Int     @default(24) @map("cancellation_min_hours")
  cancellationFeeType      String? @map("cancellation_fee_type")
  cancellationFeeAmount    Float?  @map("cancellation_fee_amount")
  maxCancellationsPerMonth Int     @default(3) @map("max_cancellations_per_month")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner                    User                      @relation("TenantOwner", fields: [ownerId], references: [id])
  memberships              TenantMembership[]
  providerPatientRelations ProviderPatientRelation[] // RENOMBRADO
  appointments             Appointment[]
  roomAssignments          RoomAssignment[] // RENOMBRADO
  auditLogs                AuditLog[]
  odontograms              Odontogram[]
  medicalServices          MedicalService[] // RENOMBRADO
  treatmentPlans           TreatmentPlan[]
  invoices                 Invoice[]

  // Phase 6 specialty modules
  exercisePlans         ExercisePlan[]
  functionalAssessments FunctionalAssessment[]
  skinLesions           SkinLesion[]
  eyeExams              EyeExam[]
  lensPrescriptions     LensPrescription[]
  cardiacAssessments    CardiacAssessment[]
  growthRecords         GrowthRecord[]
  vaccinationRecords    VaccinationRecord[]
  nutritionPlans        NutritionPlan[]
  bodyMeasurements      BodyMeasurement[]
  gynecologicalExams    GynecologicalExam[]

  // Inventory
  inventoryItems     InventoryItem[]
  inventoryMovements InventoryMovement[]

  // Insurance
  insuranceProviders InsuranceProvider[]
  patientInsurances  PatientInsurance[]

  @@index([ownerId])
  @@map("tenants")
}

model TenantMembership {
  id       String   @id @default(uuid())
  userId   String   @map("user_id")
  tenantId String   @map("tenant_id")
  role     UserRole

  permissions Json?
  status      MembershipStatus @default(PENDING_INVITATION)
  isActive    Boolean          @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([userId, tenantId])
  @@index([userId])
  @@index([tenantId])
  @@map("tenant_memberships")
}

// ==========================================
// Patient - Entidad Independiente
// ==========================================

model Patient {
  id     String  @id @default(uuid())
  userId String? @unique @map("user_id")

  // Identificación (CAMBIO: documentType + documentId como unique compuesto)
  documentType String @default("CEDULA") @map("document_type")
  documentId   String @map("document_id")

  firstName   String   @map("first_name")
  lastName    String   @map("last_name")
  dateOfBirth DateTime @map("date_of_birth")
  gender      Gender
  phone       String
  email       String? // NUEVO: email propio
  address     Json? // NUEVO: dirección

  // Datos médicos generales (propiedad del paciente)
  bloodType         String?  @map("blood_type") // NUEVO
  medicalHistory    Json?    @map("medical_history")
  allergies         String[]
  medications       String[]
  chronicConditions String[] @default([]) @map("chronic_conditions") // NUEVO

  emergencyContactName     String? @map("emergency_contact_name")
  emergencyContactPhone    String? @map("emergency_contact_phone")
  emergencyContactRelation String? @map("emergency_contact_relation") // NUEVO

  portalEnabled Boolean @default(false) @map("portal_enabled")

  // NUEVO: Preferencias de privacidad
  defaultDataAccess DataAccessLevel @default(MINIMAL) @map("default_data_access")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user                     User?                     @relation(fields: [userId], references: [id])
  providerPatientRelations ProviderPatientRelation[] // RENOMBRADO
  appointments             Appointment[]
  waitlistEntries          Waitlist[]
  treatmentPlans           TreatmentPlan[]
  invoices                 Invoice[]
  payments                 Payment[]
  documents                Document[]
  odontograms              Odontogram[]
  patientConsents          PatientConsent[] // NUEVO
  sharedDocuments          SharedDocument[] // NUEVO
  medicalExams             MedicalExam[] // NUEVO

  // Phase 6 specialty modules
  exercisePlans         ExercisePlan[]
  functionalAssessments FunctionalAssessment[]
  skinLesions           SkinLesion[]
  eyeExams              EyeExam[]
  lensPrescriptions     LensPrescription[]
  cardiacAssessments    CardiacAssessment[]
  growthRecords         GrowthRecord[]
  vaccinationRecords    VaccinationRecord[]
  nutritionPlans        NutritionPlan[]
  bodyMeasurements      BodyMeasurement[]
  gynecologicalExams    GynecologicalExam[]

  // Insurance
  patientInsurances PatientInsurance[]

  @@unique([documentType, documentId])
  @@map("patients")
}

// ==========================================
// Provider-Patient Relations (renombrado de PatientDentistRelation)
// ==========================================

model ProviderPatientRelation {
  id         String @id @default(uuid())
  patientId  String @map("patient_id")
  providerId String @map("provider_id") // RENOMBRADO de dentistId
  tenantId   String @map("tenant_id")

  // NUEVO: tipo de relación
  relationType ProviderPatientRelationType @default(REGISTERED_BY_PROVIDER) @map("relation_type")

  isActive  Boolean   @default(true) @map("is_active")
  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")

  // NUEVO: nivel de acceso que el paciente otorga
  dataAccessLevel DataAccessLevel @default(MINIMAL) @map("data_access_level")

  // NUEVO: Notas del provider (privadas)
  providerNotes String? @map("provider_notes") @db.Text

  // NUEVO: Datos locales del provider sobre este paciente
  localMedicalHistory Json?    @map("local_medical_history")
  localAllergies      String[] @default([]) @map("local_allergies")
  localMedications    String[] @default([]) @map("local_medications")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  patient Patient @relation(fields: [patientId], references: [id])
  tenant  Tenant  @relation(fields: [tenantId], references: [id])

  @@unique([patientId, providerId])
  @@index([patientId])
  @@index([providerId])
  @@index([tenantId])
  @@map("provider_patient_relations")
}

// ==========================================
// Consent System (NUEVO)
// ==========================================

model PatientConsent {
  id         String @id @default(uuid())
  patientId  String @map("patient_id")
  providerId String @map("provider_id")

  dataAccessLevel DataAccessLevel

  // Categorías específicas
  shareAppointments   Boolean @default(true) @map("share_appointments")
  shareMedicalHistory Boolean @default(false) @map("share_medical_history")
  shareDocuments      Boolean @default(false) @map("share_documents")
  shareLabResults     Boolean @default(false) @map("share_lab_results")
  shareBilling        Boolean @default(false) @map("share_billing")

  // Estado y vigencia
  status    ConsentStatus @default(PENDING)
  grantedAt DateTime?     @map("granted_at")
  revokedAt DateTime?     @map("revoked_at")
  expiresAt DateTime?     @map("expires_at")

  // Auditoría
  requestedBy String  @map("requested_by")
  reason      String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@index([providerId])
  @@index([status])
  @@index([expiresAt])
  @@map("patient_consents")
}

// ==========================================
// Shared Documents (NUEVO)
// ==========================================

model SharedDocument {
  id         String @id @default(uuid())
  patientId  String @map("patient_id")
  documentId String @map("document_id")
  providerId String @map("provider_id")

  sharedAt  DateTime  @default(now()) @map("shared_at")
  expiresAt DateTime? @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  isActive Boolean @default(true) @map("is_active")

  patient Patient @relation(fields: [patientId], references: [id])

  @@unique([documentId, providerId])
  @@index([patientId])
  @@index([providerId])
  @@index([expiresAt])
  @@map("shared_documents")
}

// ==========================================
// Medical Exams - Patient uploads (NUEVO)
// ==========================================

model MedicalExam {
  id        String @id @default(uuid())
  patientId String @map("patient_id")

  title       String
  examType    String   @map("exam_type")
  description String?  @db.Text
  examDate    DateTime @map("exam_date")

  filePath String @map("file_path")
  fileName String @map("file_name")
  fileSize Int    @map("file_size")
  mimeType String @map("mime_type")

  // Futuro: Resumen IA
  aiSummary   String? @map("ai_summary") @db.Text
  aiProcessed Boolean @default(false) @map("ai_processed")

  tags String[] @default([])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@index([examType])
  @@index([examDate])
  @@map("medical_exams")
}

// ==========================================
// Clinics & Consultation Rooms
// ==========================================

model Clinic {
  id      String @id @default(uuid())
  name    String
  address Json
  phone   String
  email   String

  latitude  Float?
  longitude Float?

  adminUserId String? @map("admin_user_id")

  floors      Int     @default(1)
  description String? @db.Text
  website     String?
  logoUrl     String? @map("logo_url")

  // NUEVO: Información de negocio
  taxId         String?            @map("tax_id")
  businessHours Json?              @map("business_hours")
  specialties   MedicalSpecialty[]
  amenities     String[]           @default([])

  // NUEVO: Configuración de alquiler
  rentalEnabled     Boolean @default(false) @map("rental_enabled")
  rentalRateHourly  Float?  @map("rental_rate_hourly")
  rentalRateDaily   Float?  @map("rental_rate_daily")
  rentalRateMonthly Float?  @map("rental_rate_monthly")

  createdBy String  @map("created_by")
  isActive  Boolean @default(true) @map("is_active")
  isPublic  Boolean @default(true) @map("is_public") // NUEVO

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  admin       User?              @relation("ClinicAdmin", fields: [adminUserId], references: [id])
  rooms       ConsultationRoom[] // RENOMBRADO de operatories
  clinicStaff ClinicStaff[] // NUEVO

  @@map("clinics")
}

model ConsultationRoom {
  id          String  @id @default(uuid())
  clinicId    String  @map("clinic_id")
  name        String
  floor       Int     @default(1)
  roomNumber  String? @map("room_number") // NUEVO
  description String?

  // NUEVO: Capacidades del consultorio
  capabilities String[] @default([])
  equipment    Json?

  // NUEVO: Configuración de scheduling
  bufferMinutes Int @default(15) @map("buffer_minutes")
  maxDailyHours Int @default(10) @map("max_daily_hours")

  // NUEVO: Alquiler
  isShared   Boolean @default(true) @map("is_shared")
  hourlyRate Float?  @map("hourly_rate")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  clinic          Clinic           @relation(fields: [clinicId], references: [id])
  roomAssignments RoomAssignment[]
  appointments    Appointment[]

  @@index([clinicId])
  @@map("consultation_rooms")
}

model RoomAssignment {
  id         String @id @default(uuid())
  roomId     String @map("room_id") // RENOMBRADO de operatoryId
  providerId String @map("provider_id") // RENOMBRADO de dentistId
  tenantId   String @map("tenant_id")

  schedule  Json
  startDate DateTime  @map("start_date")
  endDate   DateTime? @map("end_date")

  // NUEVO: Tipo de asignación
  assignmentType String @default("RECURRING") @map("assignment_type")

  // NUEVO: Para alquileres
  rentalRate   Float?  @map("rental_rate")
  rentalPeriod String? @map("rental_period")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  room   ConsultationRoom @relation(fields: [roomId], references: [id])
  tenant Tenant           @relation(fields: [tenantId], references: [id])

  @@index([roomId])
  @@index([providerId])
  @@index([tenantId])
  @@map("room_assignments")
}

// NUEVO: Staff propio de la clínica
model ClinicStaff {
  id       String @id @default(uuid())
  clinicId String @map("clinic_id")
  userId   String @map("user_id")
  role     String

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@unique([clinicId, userId])
  @@index([clinicId])
  @@index([userId])
  @@map("clinic_staff")
}

// ==========================================
// Appointments
// ==========================================

model Appointment {
  id          String  @id @default(uuid())
  patientId   String  @map("patient_id")
  providerId  String  @map("provider_id") // RENOMBRADO de dentistId
  tenantId    String  @map("tenant_id")
  roomId      String? @map("room_id") // RENOMBRADO de operatoryId
  recurringId String? @map("recurring_id")

  appointmentDate DateTime          @map("appointment_date")
  duration        Int
  status          AppointmentStatus @default(SCHEDULED)
  procedureType   String            @map("procedure_type")
  notes           String?

  // SOAP Clinical Note fields
  chiefComplaint      String? @map("chief_complaint") @db.Text
  painScale           Int?    @map("pain_scale") // 1-10
  subjectiveFindings  String? @map("subjective_findings") @db.Text
  objectiveFindings   String? @map("objective_findings") @db.Text
  assessment          String? @db.Text
  plan                String? @db.Text
  // Post-procedure
  postProcedureInstructions String? @map("post_procedure_instructions") @db.Text
  followUpNotes             String? @map("follow_up_notes") @db.Text
  nextAppointmentId         String? @map("next_appointment_id")
  // Vitals
  vitalSigns          Json?   @map("vital_signs") // { bloodPressure, pulse, temperature, etc }
  // Clinical note completion flag
  clinicalNoteComplete Boolean @default(false) @map("clinical_note_complete")

  reminderSent Boolean @default(false) @map("reminder_sent")
  confirmedVia String? @map("confirmed_via")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  patient    Patient               @relation(fields: [patientId], references: [id])
  tenant     Tenant                @relation(fields: [tenantId], references: [id])
  room       ConsultationRoom?     @relation(fields: [roomId], references: [id]) // RENOMBRADO
  recurring  RecurringAppointment? @relation(fields: [recurringId], references: [id])
  procedures   AppointmentProcedure[]
  toothHistory ToothHistory[]

  @@index([patientId])
  @@index([providerId])
  @@index([tenantId])
  @@index([appointmentDate])
  @@index([recurringId])
  @@map("appointments")
}

model AppointmentProcedure {
  id            String  @id @default(uuid())
  appointmentId String  @map("appointment_id")
  tenantId      String  @map("tenant_id")

  procedureType String  @map("procedure_type") // EXTRACTION, FILLING, CLEANING, ROOT_CANAL, CROWN, etc.
  toothNumber   Int?    @map("tooth_number") // FDI notation
  surfaces      String[] // OCCLUSAL, MESIAL, DISTAL, BUCCAL, LINGUAL
  material      String? // composite, amalgam, ceramic, etc.
  notes         String? @db.Text
  cost          Float   @default(0)
  cdtCode       String? @map("cdt_code") // CDT procedure code e.g. D2391

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@index([tenantId])
  @@map("appointment_procedures")
}

model RecurringAppointment {
  id         String  @id @default(uuid())
  patientId  String  @map("patient_id")
  providerId String  @map("provider_id") // RENOMBRADO de dentistId
  tenantId   String  @map("tenant_id")
  roomId     String? @map("room_id") // RENOMBRADO de operatoryId

  frequency RecurrenceFrequency
  interval  Int                 @default(1)
  startDate DateTime            @map("start_date")
  endDate   DateTime?           @map("end_date")

  duration      Int
  procedureType String  @map("procedure_type")
  notes         String?

  timeOfDay  String @map("time_of_day")
  daysOfWeek Int[]  @map("days_of_week")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  appointments Appointment[]

  @@index([patientId])
  @@index([providerId])
  @@index([tenantId])
  @@index([isActive])
  @@map("recurring_appointments")
}

model Waitlist {
  id         String @id @default(uuid())
  patientId  String @map("patient_id")
  providerId String @map("provider_id") // RENOMBRADO de dentistId
  tenantId   String @map("tenant_id")

  preferredDates DateTime[] @map("preferred_dates")
  preferredTimes String[]   @map("preferred_times")
  procedureType  String     @map("procedure_type")
  duration       Int
  priority       Int        @default(1)

  status WaitlistStatus @default(WAITING)
