model TreatmentPlanItem {
  id              String @id @default(uuid())
  treatmentPlanId String @map("treatment_plan_id")

  tooth   String?
  surface String?

  procedureCode String  @map("procedure_code")
  procedureName String  @map("procedure_name")
  description   String?

