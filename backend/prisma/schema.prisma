  expiresAt DateTime? @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@index([providerId])
  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
  @@map("waitlist")
}

