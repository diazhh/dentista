  provider User    @relation(fields: [providerId], references: [id])
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([providerId])
  @@index([tenantId])
  @@map("exercise_plans")
}

